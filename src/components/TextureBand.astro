---
import fs from 'node:fs';
import path from 'node:path';

/**
 * Pas przedzielający sekcje. Jeżeli w public/foto/tekstury/ leży zdjęcie,
 * ląduje w tle przyciemnione. Jeżeli nie, zostaje sama tekstura rysunkowa,
 * więc strona nigdy nie pokazuje dziury.
 */
interface Props {
  file?: string;
  quote: string;
  source: string;
}
const { file = 'wlaz-asfalt.jpg', quote, source } = Astro.props;

const rel = `foto/tekstury/${file}`;
const hasPhoto = fs.existsSync(path.join(process.cwd(), 'public', rel));
---

<section class:list={['tb', { 'tb--photo': hasPhoto }]}>
  {hasPhoto && <div class="tb__img" style={`background-image:url(/${rel})`} aria-hidden="true" />}
  <div class="shell tb__inner">
    <blockquote class="tb__quote">
      <p class="display-m">{quote}</p>
      <footer class="mono tb__src">{source}</footer>
    </blockquote>
  </div>
</section>

<style>
  .tb {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--elev);
    border-block: 1px solid var(--rule);
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  /* tekstura rysunkowa: skośna kreska, ta sama co szraf na przekroju */
  .tb::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: repeating-linear-gradient(
      45deg,
      var(--rule) 0 1px,
      transparent 1px 9px
    );
    opacity: 0.7;
  }

  .tb__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    filter: grayscale(1) contrast(1.15);
  }
  .tb--photo::before { opacity: 0.25; }

  .tb__quote { margin: 0; max-width: 26ch; }
  .tb__quote p { margin: 0; }
  .tb__src {
    margin-top: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .tb__quote { max-width: none; }
  }
</style>
