---
import { site } from '../data/site';
---

<section class="strip" aria-label="Kluczowe parametry">
  <div class="shell strip__grid">
    {
      site.stats.map((s) => (
        <div class="strip__cell">
          <p class="strip__val mono">
            {s.value}
            <span class="strip__unit">{s.unit}</span>
          </p>
          <p class="label">{s.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Tabliczka znamionowa, nie pasek statystyk. Wartość jest elementem
     display: duża, tabularna, wybita na tle sekcji. Etykieta siedzi POD
     kreską, jak podpis pola w karcie katalogowej. */
  .strip {
    border-bottom: 1px solid var(--rule);
  }
  .strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .strip__cell {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 1.25rem;
    padding-inline-end: 1.25rem;
  }
  .strip__cell + .strip__cell {
    border-inline-start: 1px solid var(--rule);
    padding-inline-start: 1.25rem;
  }
  .strip__cell:nth-child(3) { border-inline-start: 0; padding-inline-start: 0; }
  .strip__val {
    font-size: clamp(1.5rem, 3.1vw, 2.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
  .strip__unit {
    font-size: 0.44em;
    color: var(--accent-text);
    margin-inline-start: 0.4em;
    letter-spacing: 0.06em;
  }
  .strip .label {
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 400px) {
    .strip__val { font-size: 1.25rem; }
  }
  @media (min-width: 640px) {
    .strip__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strip__cell:nth-child(3) { border-inline-start: 1px solid var(--rule); padding-inline-start: 1.25rem; }
    .strip__cell:nth-child(4) { border-inline-start: 0; padding-inline-start: 0; }
  }
  @media (min-width: 1000px) {
    .strip__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .strip__cell:nth-child(4) { border-inline-start: 1px solid var(--rule); padding-inline-start: 1.25rem; }
  }
</style>
