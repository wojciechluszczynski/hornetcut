---
/**
 * Rysunkowy zestaw ikon. Ta sama kreska co rysunek CAD w hero: hairline,
 * bez wypełnień, bez zaokrągleń dekoracyjnych. Żadnej biblioteki.
 */
interface Props {
  name: 'poziom' | 'wlaz' | 'droga' | 'siec' | 'plac' | 'awaria';
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  class:list={['ico', cls]}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
>
  {
    name === 'poziom' && (
      <>
        {/* regulacja wysokości: właz podnoszony do poziomu nawierzchni */}
        <line x1="3" y1="30" x2="45" y2="30" />
        <line x1="3" y1="36" x2="45" y2="36" stroke-opacity="0.45" />
        <rect x="16" y="18" width="16" height="12" />
        <line x1="16" y1="24" x2="32" y2="24" stroke-opacity="0.45" />
        <path d="M24 14 V6" class="ico__a" />
        <path d="M20 9 L24 5 L28 9" class="ico__a" />
      </>
    )
  }
  {
    name === 'wlaz' && (
      <>
        {/* wymiana włazu: pierścień zdejmowany z korpusu */}
        <ellipse cx="24" cy="14" rx="15" ry="6" class="ico__a" />
        <ellipse cx="24" cy="30" rx="15" ry="6" />
        <path d="M9 30 V38" />
        <path d="M39 30 V38" />
        <ellipse cx="24" cy="38" rx="15" ry="6" stroke-opacity="0.45" />
        <ellipse cx="24" cy="14" rx="6" ry="2.4" stroke-opacity="0.45" />
      </>
    )
  }
  {
    name === 'droga' && (
      <>
        {/* remont drogi: warstwy nawierzchni i wycięty pierścień */}
        <path d="M4 16 H44" />
        <path d="M4 26 H44" stroke-opacity="0.45" />
        <path d="M4 36 H44" stroke-opacity="0.45" />
        <path d="M18 16 V36" class="ico__a" />
        <path d="M30 16 V36" class="ico__a" />
        <path d="M8 21 h6 M20 21 h8 M34 21 h6" stroke-opacity="0.3" />
      </>
    )
  }
  {
    name === 'siec' && (
      <>
        {/* sieci podziemne: rura i przyłącze pod nawierzchnią */}
        <path d="M3 12 H45" />
        <path d="M8 24 H40" />
        <path d="M8 30 H40" />
        <path d="M8 24 a3 3 0 0 0 -3 3 a3 3 0 0 0 3 3" />
        <path d="M40 24 a3 3 0 0 1 3 3 a3 3 0 0 1 -3 3" />
        <path d="M24 12 V24" class="ico__a" />
        <circle cx="24" cy="12" r="3" class="ico__a" />
      </>
    )
  }
  {
    name === 'plac' && (
      <>
        {/* plac i parking: siatka płyt z jednym wyciętym okręgiem */}
        <rect x="5" y="9" width="38" height="30" />
        <path d="M5 19 H43 M5 29 H43 M17.6 9 V39 M30.3 9 V39" stroke-opacity="0.4" />
        <circle cx="24" cy="24" r="6.5" class="ico__a" stroke-dasharray="3 2.5" />
      </>
    )
  }
  {
    name === 'awaria' && (
      <>
        {/* awaria: znak ostrzegawczy i zegar */}
        <path d="M18 8 L4 34 H32 Z" />
        <path d="M18 17 V25" />
        <circle cx="18" cy="29.5" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="35" cy="30" r="9" class="ico__a" />
        <path d="M35 25 V30 L38.5 32" class="ico__a" />
      </>
    )
  }
</svg>

<style>
  .ico {
    width: 44px;
    height: 44px;
    color: var(--muted);
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .ico__a { stroke: var(--accent-text); }
</style>
