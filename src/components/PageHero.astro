---
import Figure from './Figure.astro';

interface Props {
  h1: string;
  lead?: string;
  crumbs: { label: string; href: string }[];
  /** Numer arkusza w szynie, np. "03". Strony bez numeru (404, podziękowanie)
      pomijają go i dostają samą etykietę. */
  sheet?: string;
  /** Etykieta pod numerem. Domyślnie ostatni okruszek. */
  sheetLabel?: string;
  /** Wpis z site.media. Renderuje się we własnych proporcjach, bez kadrowania. */
  photo?: { src: string; alt: string; w: number; h: number };
}
const { h1, lead, crumbs, sheet, sheetLabel, photo } = Astro.props;
const mark = sheetLabel ?? crumbs.at(-1)?.label ?? '';
---

{/* Ten sam arkusz co na stronie głównej: szyna z numerem po lewej, treść w
    drugiej kolumnie. Bez tego podstrony wracały do wyśrodkowanego stosu
    sekcji, czyli dokładnie do układu, od którego strona główna odeszła. */}
<section class="phero">
  <div class="sheet">
    <p class="smark">
      {sheet && <b>{sheet}</b>}
      <span>{mark}</span>
    </p>

    <nav class="phero__crumbs mono" aria-label="Okruszki">
      <a href="/">Strona główna</a>
      {
        crumbs.map((c, i) => (
          <>
            <span aria-hidden="true">/</span>
            {i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
          </>
        ))
      }
    </nav>

    <h1 class="display-xl">
      {h1.split('\n').map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </h1>

    {lead && <p class="lead muted phero__lead">{lead}</p>}

    {photo && <Figure {...photo} caption={photo.alt} priority class="phero__fig" />}
  </div>

  <div class="measure phero__strip" aria-hidden="true"></div>
</section>

<style>
  .phero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
  }
  .phero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .phero__crumbs a:hover { color: var(--accent-text); }
  .phero__crumbs [aria-current] { color: var(--fg); }
  .phero__lead { margin-top: 1.75rem; }
  .phero__fig { margin-top: clamp(2rem, 4vw, 3rem); }
  /* Podziałka zamyka nagłówek zamiast pełnej kreski: ta sama krawędź, którą
     hero na stronie głównej oddziela od paska liczb. */
  .phero__strip { margin-top: clamp(2.5rem, 4vw, 3.5rem); }
</style>
