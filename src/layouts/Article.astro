---
import Base from './Base.astro';
import NextLinks from '../components/NextLinks.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  h1: string;
  lead: string;
  published: string;
  updated?: string;
  readMin: number;
  slug: string;
}
const { title, description, h1, lead, published, updated, readMin, slug } = Astro.props;

const crumbs = [
  { label: 'Poradnik', href: '/poradnik/' },
  { label: h1, href: `/poradnik/${slug}/` },
];

const schema = [
  {
    '@type': 'Article',
    headline: h1,
    description,
    datePublished: published,
    dateModified: updated ?? published,
    inLanguage: 'pl-PL',
    author: { '@id': `${site.meta.url}/#organizacja` },
    publisher: { '@id': `${site.meta.url}/#organizacja` },
    mainEntityOfPage: `${site.meta.url}/poradnik/${slug}/`,
    about: { '@id': `${site.meta.url}/#produkt` },
  },
];
---

<Base title={title} description={description} schema={schema} crumbs={crumbs}>
  <article class="art">
    <header class="art__head">
      <div class="shell art__headInner">
        <nav class="art__crumbs mono" aria-label="Okruszki">
          <a href="/">Start</a>
          <span aria-hidden="true">/</span>
          <a href="/poradnik/">Poradnik</a>
        </nav>
        <h1 class="display-l art__h1">{h1}</h1>
        <p class="lead muted art__lead">{lead}</p>
        <p class="art__meta mono">
          <time datetime={published}>
            {new Date(published).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <span aria-hidden="true">·</span>
          <span>{readMin} min czytania</span>
        </p>
      </div>
    </header>

    <div class="shell art__body">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>

  <section class="band band--paper band--tight">
    <div class="shell cta">
      <h2 class="display-l">Masz konkretny odcinek do zrobienia?</h2>
      <p class="lead muted">
        Napisz, ile studzienek, jaka nawierzchnia i jaki termin. Odpowiemy ceną i doborem tarczy.
      </p>
      <a href="/kontakt/" class="btn btn--solid">Zapytaj o cenę</a>
    </div>

    <div class="shell">
      <NextLinks
        items={[
          { label: 'Dane techniczne R650', href: '/dane-techniczne/', note: 'Pełna tabela parametrów' },
          { label: 'Jak to działa', href: '/jak-to-dziala/', note: 'Cztery kroki i wideo' },
          { label: 'Poradnik', href: '/poradnik/', note: 'Pozostałe teksty' },
        ]}
      />
    </div>
  </section>
</Base>

<style is:global>
  .art__head {
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 2.75rem);
  }
  .art__headInner { max-width: 62rem; }
  .art__crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.75rem;
  }
  .art__crumbs a { color: inherit; text-decoration: none; }
  .art__crumbs a:hover { color: var(--accent-text); }
  .art__h1 { max-width: 22ch; }
  .art__lead { margin-top: 1.25rem; max-width: 60ch; }
  .art__meta {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .art__body { padding-block: clamp(2.5rem, 5vw, 4rem); }

  .prose { max-width: 68ch; }
  .prose > * + * { margin-top: 1.25rem; }
  .prose h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    font-stretch: 108%;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-top: clamp(2.75rem, 5vw, 3.75rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .prose h3 {
    font-size: 1.05rem;
    font-stretch: 104%;
    font-weight: 700;
    margin-top: 2rem;
  }
  .prose p { color: var(--muted); line-height: 1.65; }
  .prose strong { color: var(--fg); font-weight: 600; }
  .prose a { color: var(--accent-text); text-underline-offset: 3px; }

  .prose ul,
  .prose ol { padding-left: 1.1rem; color: var(--muted); line-height: 1.6; }
  .prose li + li { margin-top: 0.5rem; }
  .prose ul { list-style: none; padding-left: 0; }
  .prose ul > li { position: relative; padding-left: 1.4rem; }
  .prose ul > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--color-amber);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 0.7rem 0.75rem 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose th {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  .prose td:last-child { color: var(--muted); }

  .prose .callout {
    border-left: 2px solid var(--color-amber);
    padding: 0.25rem 0 0.25rem 1.25rem;
  }
  .prose .callout p { color: var(--fg); }

  .prose figure { margin: 2.5rem 0; }
  .prose figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
    margin-top: 0.9rem;
  }

  @media (max-width: 700px) {
    .prose table { display: block; overflow-x: auto; }
  }
</style>
