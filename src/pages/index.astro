---
import Base from '../layouts/Base.astro';
import CutDiagram from '../components/CutDiagram.astro';
import StatStrip from '../components/StatStrip.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Figure from '../components/Figure.astro';
import VideoSlot from '../components/VideoSlot.astro';
import SpecTable from '../components/SpecTable.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import Val from '../components/Val.astro';
import Icon from '../components/Icon.astro';
import RoadSection from '../components/RoadSection.astro';
import TextureBand from '../components/TextureBand.astro';
import { site } from '../data/site';
import { plain } from '../lib/val';

const homeFaq = site.faq.items.filter((i) => i.home);

const schema = [
  {
    '@type': 'Product',
    '@id': `${site.meta.url}/#produkt`,
    name: site.meta.model,
    category: 'Wycinarka okręgów do studzienek kanalizacyjnych',
    description: site.meta.description,
    brand: { '@type': 'Brand', name: site.meta.brand },
    manufacturer: { '@id': `${site.meta.url}/#organizacja` },
    url: site.meta.url,
    additionalProperty: site.specs.rows
      .filter((r) => !r.v.startsWith('?'))
      .map((r) => ({ '@type': 'PropertyValue', name: r.k, value: r.v })),
    offers: {
      '@type': 'Offer',
      priceCurrency: 'PLN',
      availability: 'https://schema.org/InStock',
      url: `${site.meta.url}/kontakt/`,
      seller: { '@id': `${site.meta.url}/#organizacja` },
    },
  },
  {
    '@type': 'HowTo',
    name: 'Jak wyciąć okrąg wokół studzienki kanalizacyjnej',
    totalTime: 'PT30M',
    tool: [{ '@type': 'HowToTool', name: site.meta.model }],
    step: site.how.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.body,
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: homeFaq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: plain(item.a) },
    })),
  },
];
---

<Base title={site.meta.title} description={site.meta.description} schema={schema}>
  {/* ------------------------------------------------ 01 HERO */}
  <section class="hero" id="maszyna">
    {/* Łuk zakreślony wokół osi leżącej poza kadrem: dokładnie to, co robi
        maszyna. Wraca niżej jako separator sekcji. */}
    <svg class="arc hero__arc" viewBox="0 0 1400 900" preserveAspectRatio="xMinYMin slice" aria-hidden="true">
      <circle cx="150" cy="1240" r="1120"></circle>
      <circle cx="150" cy="1240" r="900"></circle>
      <circle
        class="arc__live"
        cx="150"
        cy="1240"
        r="1010"
        pathLength="100"
        stroke-dasharray="13 87"
        stroke-dashoffset="-4"></circle>
    </svg>

    <div class="sheet sheet--free hero__sheet">
      <p class="smark">
        <b>01</b><span>Rzut z góry</span>
      </p>

      <div class="hero__head">
        <p class="label hero__eyebrow">{site.hero.eyebrow}</p>
        <h1 class="display-xl">
          {site.hero.h1.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h1>
      </div>

      <div class="hero__text">
        <p class="lead muted hero__lead">{site.hero.lead}</p>
        <div class="hero__cta">
          <a href={site.hero.ctaPrimary.href} class="btn btn--solid">{site.hero.ctaPrimary.label}</a>
          <a href={site.hero.ctaSecondary.href} class="link-amber">{site.hero.ctaSecondary.label}</a>
        </div>
      </div>

      <div class="hero__dgm">
        {/* Klient chce widziec maszyne od razu, zanim zacznie czytac. Rysunek
            techniczny przeniesiony do sekcji 04, gdzie tlumaczymy samo ciecie. */}
        <Figure {...site.media.hero} caption={site.media.hero.alt} id="01" priority />
      </div>
    </div>

    <div class="measure hero__strip" aria-hidden="true"></div>
  </section>

  <StatStrip />

  {/* ------------------------------------------------ 02 PAIN AND GAIN */}
  <section class="band">
    <div class="sheet">
      <p class="smark"><b>02</b><span>{site.pains.eyebrow}</span></p>
      <div class="pg__head">
        <h2 class="display-l">{site.pains.h2}</h2>
        <p class="lead muted">{site.pains.lead}</p>
      </div>
      <Figure
        {...site.media.pain}
        caption={site.media.pain.alt}
        class="pg__fig reveal"
      />

      <div class="pg">
        <p class="pg__col label">Tak jest zwykle</p>
        <p class="pg__col label pg__col--gain">Z HornetCut R650</p>
        {
          site.pains.rows.map((row) => (
            <>
              <p class="pg__pain reveal">{row.pain}</p>
              <p class="pg__gain reveal">{row.gain}</p>
            </>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 03 METHOD COMPARISON */}
  <section class="band band--wide">
    <div class="sheet">
      <p class="smark"><b>03</b><span>{site.why.eyebrow}</span></p>
      <div class="why__head">
        <h2 class="display-l">{site.why.h2}</h2>
        <div class="why__body">
          {site.why.body.map((p) => <p class="muted">{p}</p>)}
        </div>
      </div>

      <div class="why__figure reveal">
        <RoadSection />
      </div>

      <figure class="why__shot reveal">
        <PhotoSlot {...site.photos.ring} />
        <figcaption class="mono why__cap">
          Pierścień nawierzchni zdjęty wokół włazu. Krawędź pionowa, korpus studni nietknięty.
        </figcaption>
      </figure>

      <div class="why__rows">
        {
          site.why.rows.map((row) => (
            <div class:list={['why__row', 'reveal', { 'is-hero': row.highlight }]}>
              <p class="why__method">
                {row.highlight && <span class="why__dot" aria-hidden="true" />}
                {row.method}
              </p>
              <ul class="why__marks mono">
                {row.marks.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 04 HOW IT WORKS */}
  <section class="band band--paper">
    <div class="sheet">
      <p class="smark"><b>04</b><span>{site.how.eyebrow}</span></p>
      <h2 class="display-l how__h2">{site.how.h2}</h2>

      <ol class="how__steps">
        {
          site.how.steps.map((step, i) => (
            <li class="how__step reveal">
              <span class="how__idx mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="how__title">{step.title}</h3>
              <p class="muted">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="how__dgm">
        <CutDiagram />
      </div>

      <div class="how__video">
        <VideoSlot
          youtubeId={site.how.video.youtubeId}
          file={site.how.video.file}
          poster={site.how.video.poster}
          caption={site.how.video.caption}
          title={site.how.video.title}
        />
      </div>
    </div>
  </section>

  <TextureBand
    video={site.media.loop.video}
    poster={site.media.loop.poster}
    quote="Studzienka nie jest problemem. Problemem jest to, co trzeba rozebrać, żeby się do niej dostać."
    source="WOSK.650R LP, cięcie po obwodzie"
  />

  {/* ------------------------------------------------ 05 PEOPLE */}
  <section class="band">
    <div class="sheet">
      <p class="smark"><b>05</b><span>{site.people.eyebrow}</span></p>
      <div class="pp">
        <div class="pp__text">
          <h2 class="display-l">{site.people.h2}</h2>
          <p class="lead muted pp__body">{site.people.body}</p>

          <blockquote class="pp__quote">
            <p><Val text={site.people.quote.text} /></p>
            <footer class="mono">
              <Val text={site.people.quote.author} />, <Val text={site.people.quote.role} />
            </footer>
          </blockquote>

          <dl class="pp__facts">
            {
              site.people.facts.map((f) => (
                <div>
                  <dt class="label">{f.k}</dt>
                  <dd class="mono">
                    <Val text={f.v} />
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="pp__shots">
          <PhotoSlot {...site.photos.crew} />
        </div>
      </div>

      <div class="shots" role="group" aria-label="Zdjęcia z budowy, przewiń w bok">
        <PhotoSlot {...site.photos.work} />
        <PhotoSlot {...site.photos.handover} />
        <PhotoSlot {...site.photos.site} />
        <PhotoSlot {...site.photos.transport} />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 06 USES */}
  <section class="band band--wide">
    <div class="sheet">
      <p class="smark"><b>06</b><span>{site.uses.eyebrow}</span></p>
      <div class="uses__head">
        <h2 class="display-l">{site.uses.h2}</h2>
        <a href="/zastosowania/" class="link-amber">Rozwinięte opisy</a>
      </div>

      <div class="uses__layout">
        <div class="matrix uses__matrix">
          {
            site.uses.items.map((item) => (
              <div class="reveal">
                <Icon name={item.icon} class="uses__ico" />
                <h3 class="uses__title">{item.title}</h3>
                <p class="muted uses__body">{item.body}</p>
              </div>
            ))
          }
        </div>
        <PhotoSlot {...site.photos.hero} class="uses__photo" />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 07 EQUIPMENT */}
  <section class="band">
    <div class="sheet">
      <p class="smark"><b>07</b><span>{site.equipment.eyebrow}</span></p>
      <div class="eq">
        <div class="eq__left">
          <h2 class="display-l">{site.equipment.h2}</h2>
          <PhotoSlot {...site.photos.detail} class="eq__photo" />
        </div>
        <dl class="eq__list">
          {
            site.equipment.items.map((item) => (
              <div class="eq__item reveal">
                <dt>{item.title}</dt>
                <dd class="muted">{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 08 SPECS */}
  <section class="band band--paper">
    <div class="sheet">
      <p class="smark"><b>08</b><span>{site.specs.eyebrow}</span></p>
      <div class="specs">
        <div class="specs__left">
          <h2 class="display-l">{site.specs.h2}</h2>
          <p class="muted specs__note">
            Dane katalogowe maszyny w konfiguracji standardowej, wprost z karty producenta
            i instrukcji obsługi WOSK.650R LP.
          </p>
          <a href="/dane-techniczne/" class="link-amber">Pełna specyfikacja</a>
        </div>
        <div class="specs__table">
          <SpecTable caption={site.specs.caption} rows={site.specs.rows} />
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 09 MAKER */}
  <section class="band band--tight">
    <div class="sheet">
      <p class="smark"><b>09</b><span>{site.maker.eyebrow}</span></p>
      <div class="mk">
        <div>
          <h2 class="display-l">{site.maker.h2}</h2>
          <p class="lead muted mk__body">{site.maker.body}</p>
          <p class="mk__links">
            {
              site.maker.links.map((l) => (
                <a href={l.href} class="link-amber" rel="noopener">
                  {l.label}
                </a>
              ))
            }
          </p>
        </div>
        <dl class="mk__facts">
          {
            site.maker.facts.map((f) => (
              <div class="mk__fact">
                <dt class="label">{f.k}</dt>
                <dd class="mono">
                  <Val text={f.v} />
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 10 FAQ */}
  <section class="band">
    <div class="sheet">
      <p class="smark"><b>10</b><span>{site.faq.eyebrow}</span></p>
      <div class="faq__layout">
        <div>
          <h2 class="display-l">{site.faq.h2}</h2>
          <a href="/faq/" class="link-amber faq__more">Wszystkie pytania</a>
        </div>
        <Faq items={homeFaq} />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ 11 CONTACT */}
  <section class="band" id="kontakt">
    <div class="sheet">
      <p class="smark"><b>11</b><span>{site.form.eyebrow}</span></p>
      <div class="ct">
        <div class="ct__left">
          <h2 class="display-l">{site.form.h2}</h2>
          <p class="lead muted ct__intro">{site.form.intro}</p>
          <dl class="ct__data mono">
            <div>
              <dt class="label">Telefon</dt>
              <dd>
                <a href={`tel:${plain(site.contact.phoneHref)}`}><Val text={site.contact.phone} /></a>
              </dd>
            </div>
            <div>
              <dt class="label">E-mail</dt>
              <dd>
                <a href={`mailto:${plain(site.contact.email)}`}><Val text={site.contact.email} /></a>
              </dd>
            </div>
            <div>
              <dt class="label">Godziny</dt>
              <dd>{site.contact.hours}</dd>
            </div>
          </dl>
        </div>
        <div class="ct__form">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 01 hero ---------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
  }

  /* Siatka rysunkowa w tle, drobniejsza niż wcześniej i wygaszona po lewej,
     żeby nie konkurowała ani z łukiem, ani z rysunkiem CAD. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -12% -8%;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--rule) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rule) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.4;
    -webkit-mask-image: radial-gradient(105% 80% at 82% 42%, #000 10%, transparent 70%);
    mask-image: radial-gradient(105% 80% at 82% 42%, #000 10%, transparent 70%);
    animation: grid-drift 120s linear infinite;
  }
  /* Łuk musi zostać poza układem, więc wyłączamy go z tej reguły —
     inaczej dostaje position:relative i zjada wysokość sekcji. */
  .hero > *:not(.hero__arc) { position: relative; z-index: 1; }

  @keyframes grid-drift {
    to { background-position: 48px 48px, 48px 48px; }
  }

  /* Łuk: pełna szerokość sekcji, oś poza dolną krawędzią kadru. */
  /* Łuk ma być czytelny jako geometria, nie jako tekstura pod tekstem —
     wygaszony maską tam, gdzie leży nagłówek. */
  .hero__arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0 34%, #000 52%);
    mask-image: linear-gradient(to bottom, transparent 0 34%, #000 52%);
  }

  /* Poniżej 1100 px .sheet nie jest siatką, więc row-gap nie działa i bloki
     hero stykają się ze sobą. Odstępy ustawiamy wprost. */
  .hero__sheet { row-gap: clamp(2.5rem, 5vw, 3.5rem); }
  .hero__head { margin-top: 1.75rem; }
  .hero__text { margin-top: 2rem; }
  .hero__dgm { margin-top: 2.75rem; }
  .hero__eyebrow { margin-bottom: 1.5rem; }
  .hero__lead { margin-top: 1.75rem; }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
    margin-top: 2.5rem;
  }
  .hero__strip { margin-top: clamp(2.5rem, 5vw, 4rem); }

  /* Nagłówek idzie przez obie kolumny treści jak napis na tablicy, a dopiero
     pod nim rozjeżdżają się lead i rysunek. Szyna trzyma lewą krawędź. */
  @media (min-width: 1100px) {
    .hero {
      padding-block: clamp(2.5rem, 5vw, 4rem) 0;
      /* Bez min-height: sekcja ma być wysoka na tyle, ile niesie treść.
         Wymuszona wysokość zostawiała martwy róg pod przyciskami. */
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .hero__sheet {
      grid-template-columns: var(--rail) minmax(0, 4.9fr) minmax(0, 7.1fr);
      column-gap: clamp(1.75rem, 2.8vw, 3rem);
      row-gap: clamp(1.75rem, 3.2vw, 2.75rem);
      align-items: start;
    }
    /* Na desktopie odstępy niesie już siatka, więc marginesy z mobile znikają. */
    .hero__head { grid-column: 2 / 4; grid-row: 1; margin-top: 0; }
    .hero__text { grid-column: 2; grid-row: 2; align-self: start; margin-top: 0; }
    .hero__dgm  { grid-column: 3; grid-row: 2; margin-top: -1.5rem; }
    .hero__lead { margin-top: 0; }
  }

  /* 02 pain and gain ------------------------------------------- */
  .pg__head { display: grid; gap: 1.5rem; margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  @media (min-width: 900px) {
    .pg__head { grid-template-columns: 1.1fr 1fr; gap: 3.5rem; align-items: end; }
  }
  .pg { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--rule); }
  .pg__col { padding-block: 0.9rem; display: none; }
  .pg__pain,
  .pg__gain {
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
  .pg__pain { color: var(--muted); }
  .pg__gain { font-weight: 500; padding-left: 1.5rem; position: relative; }
  .pg__gain::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.6rem;
    width: 8px;
    height: 8px;
    background: var(--color-amber);
  }
  @media (min-width: 820px) {
    .pg { grid-template-columns: 1fr 1fr; column-gap: 3rem; }
    .pg__col { display: block; border-bottom: 1px solid var(--rule); }
    .pg__fig { margin-block: clamp(2rem, 4vw, 3rem); }
  .pg__col--gain { color: var(--accent-text); }
    .pg__pain, .pg__gain { padding-block: 1.35rem; }
  }

  /* 03 method comparison --------------------------------------- */
  .why__head { display: grid; gap: 2rem; }
  .why__body { display: grid; gap: 1.1rem; max-width: 60ch; }
  @media (min-width: 900px) {
    .why__head { grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; }
  }
  .why__figure { margin-top: clamp(2.5rem, 4vw, 3.5rem); }
  .why__shot { margin: clamp(2.5rem, 4vw, 3.5rem) 0 0; }
  .why__cap {
    margin-top: 0.9rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 60ch;
  }
  .why__rows { margin-top: clamp(3rem, 5vw, 4.5rem); border-top: 1px solid var(--rule); }
  .why__row {
    display: grid;
    gap: 0.85rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .why__method {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 108%;
    text-transform: uppercase;
    font-size: 1.0625rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .why__row.is-hero .why__method { font-weight: 800; }
  .why__dot { width: 9px; height: 9px; background: var(--color-amber); flex: none; }
  .why__marks {
    display: grid;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    list-style: none;
  }
  .why__marks li::before { content: '· '; color: var(--accent-text); }
  @media (min-width: 900px) {
    .why__row { grid-template-columns: 1fr 2fr; gap: 3rem; align-items: baseline; }
    .why__marks { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }

  /* 04 how ----------------------------------------------------- */
  .how__h2 { max-width: 16ch; }
  .how__steps {
    display: grid;
    gap: 0;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .how__step { padding-block: 1.75rem; border-bottom: 1px solid var(--rule); }
  .how__idx { display: block; font-size: 0.75rem; color: var(--accent-text); letter-spacing: 0.2em; }
  .how__title { font-size: 1.125rem; margin-block: 0.75rem 0.6rem; font-stretch: 106%; }
  .how__step p { font-size: 0.9375rem; max-width: 42ch; }
  @media (min-width: 900px) {
    .how__steps { grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--rule); }
    .how__step { border-bottom: 0; padding: 2rem 1.75rem 2.25rem 0; }
    .how__step + .how__step { border-left: 1px solid var(--rule); padding-left: 1.75rem; }
  }
  .how__video { margin-top: clamp(2.5rem, 4vw, 3.5rem); max-width: 980px; }

  /* 05 people -------------------------------------------------- */
  .pp { display: grid; gap: 2.5rem; }
  .pp__body { margin-top: 1.5rem; }
  .pp__quote { margin: 2.25rem 0 0; padding-left: 1.5rem; border-left: 2px solid var(--color-amber); }
  .pp__quote p { font-size: 1.0625rem; line-height: 1.5; max-width: 48ch; }
  .pp__quote footer { margin-top: 0.85rem; font-size: 0.75rem; color: var(--muted); letter-spacing: 0.08em; }
  .pp__facts { display: grid; gap: 0; margin-top: 2.25rem; border-top: 1px solid var(--rule); }
  .pp__facts > div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }
  .pp__facts dd { font-size: 0.875rem; text-align: right; }
  .pp__shots { display: grid; gap: 1.25rem; align-content: start; }

  /* Przewijany pas zdjęć. Bez biblioteki: scroll-snap i pasek przewijania,
     który na desktopie pokazuje trzy kadry, a na telefonie półtora. */
  .shots {
    display: grid;
    grid-auto-flow: column;
